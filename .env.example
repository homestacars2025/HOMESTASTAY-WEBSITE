# Supabase — Homesta Stay
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Server-only: NEVER import this in Client Components
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Resend
RESEND_API_KEY=re_xxxxxxxxxxxxx

# Mapbox — public token for the unit-detail map. Ships to the browser, so
# restrict it by URL in the Mapbox dashboard. Without it the map section hides.
NEXT_PUBLIC_MAPBOX_TOKEN=pk.xxxxxxxxxxxxx

# ── Origins — TWO variables, deliberately not one ─────────────────────────────
# They are identical in production and MUST differ on preview.
#
# Canonical: ALWAYS the production origin, on every deployment including
# previews. Canonical/hreflang/OG must point at production, or each preview
# advertises itself as canonical and invites Google to index it.
# Note the www host: the apex 307-redirects to www.
NEXT_PUBLIC_CANONICAL_URL=https://www.homestastay.com

# Payment callback: the origin the BANK must reach for THIS deployment. It is
# hashed into HashData, so it has to be byte-identical to where the bank
# actually lands — use the stable branch alias on preview (never the
# per-deployment URL, which changes on every push), and pin the www host: a
# 307 from the apex is exactly the mismatch that surfaces as HashDataError.
# Server-only on purpose — no NEXT_PUBLIC_ prefix, so it cannot be reached for
# by accident when writing a canonical tag.
PAYMENT_CALLBACK_ORIGIN=https://www.homestastay.com

# ── Booking flow ──────────────────────────────────────────────────────────────
# Signs the httpOnly cookie carrying booking_id from the details form to the
# payment step. Any long random string: `openssl rand -base64 32`.
# Rotating it invalidates in-flight holds — guests restart, nothing worse.
BOOKING_COOKIE_SECRET=replace-me-openssl-rand-base64-32

# ── Kuveyt Türk 3D Secure — server-only, Phase B ──────────────────────────────
# NEVER give these a NEXT_PUBLIC_ prefix. Real values belong in .env.local and
# the Vercel dashboard, never in a committed file.
#
# CustomerId is the Müşteri No and is NOT the same as MerchantId (Mağaza No).
# Setting both to the Mağaza No fails at provision with InvalidMetaData.
#
# Do NOT log into the bank panel as the API user. A panel password change
# invalidates the credential at the API layer while the panel still shows it
# valid, producing a permanent HashDataError with no way back.
#
# All bank traffic must go through the proxy — its IP is whitelisted at the
# bank and Vercel's egress IPs are not, so direct calls time out.
KUVEYT_MERCHANT_ID=
KUVEYT_CUSTOMER_ID=
KUVEYT_API_USERNAME=
KUVEYT_API_PASSWORD=
KUVEYT_PROXY_BASE_URL=https://pay-proxy-caddy.gdsddq.easypanel.host

# ── Refund (SaleReversal / DrawBack / PartialDrawback) — server-only ──────────
# The refund is SOAP 1.1 to the WCF query API, reusing the KUVEYT_* credentials
# above and going through the same proxy. The production host is the same BOA
# host the payment proxy already reaches; only the path differs — and it MUST
# end in `.svc/Basic` (the basicHttpBinding endpoint). A POST to the bare `.svc`
# 404s; `.svc/Basic` returns a real SOAP envelope. Verified live + against the
# mews/pos KuveytPos reference. Stays gated until a live reversal is verified
# end-to-end.
#
# Shared secret the trigger (resolve_owner_reply → pg_net) must send as the
# x-refund-secret header. Without it the route is closed. `openssl rand -hex 32`.
REFUND_TRIGGER_SECRET=
# 'true' to allow the actual bank call. Anything else = gated (no bank call).
REFUND_LIVE_ENABLED=
# SOAPAction base = WCF contract + '/' + operation (SaleReversal|DrawBack|
# PartialDrawback). This is the confirmed value; override only to experiment.
KUVEYT_REFUND_SOAP_ACTION_BASE=http://boa.net/BOA.Integration.VirtualPos/Service/IVirtualPosService
# The WCF query-API path. MUST end in `.svc/Basic` — the bare `.svc` 404s on POST.
KUVEYT_REFUND_SERVICE_PATH=/BOA.Integration.WCFService/BOA.Integration.VirtualPos/VirtualPosService.svc/Basic

# ── Auth ──────────────────────────────────────────────────────────────────────
# Origin the Google OAuth callback returns to. OPTIONAL: when unset the browser
# uses window.location.origin, which is already right in dev, preview and
# production. Set it only to pin one host — e.g. so preview deployments send
# people back to the production domain. NOT the same as NEXT_PUBLIC_CANONICAL_URL,
# which always resolves to production and would bounce a local sign-in to the
# live site holding the code.
#
# Whatever this resolves to, "<origin>/api/auth/callback" must be listed under
# Authentication → URL Configuration → Redirect URLs in Supabase, and the Google
# provider must be enabled there with its client ID and secret.
NEXT_PUBLIC_SITE_URL=

# ── Cache invalidation ────────────────────────────────────────────────────────
# Shared secret for /api/revalidate. Supabase Database Webhooks send it as the
# x-revalidate-secret header. Unset = the route is closed. `openssl rand -hex 32`.
REVALIDATE_SECRET=

# Shared secret for the /api/og/warm cron (vercel.json), which pre-generates the
# social share cards so a guest's first share is never the slow one. Vercel's
# scheduler sends it as `Authorization: Bearer …` automatically once it is set
# in the project. Unset = the route is closed and the cards warm lazily instead.
# The route also accepts REVALIDATE_SECRET via x-revalidate-secret, for warming
# by hand after a bulk import. `openssl rand -hex 32`.
CRON_SECRET=

# ── TLYNC (TDSP) — Libyan payment aggregator, server-only ─────────────────────
# The second gateway. Guests choose between the Kuveyt Türk card flow and this
# one at the payment step; TLYNC bundles the Libyan methods (Tadawul, MobiCash,
# …) on its OWN hosted page, so there is no method picker on our side.
#
# TLYNC_ENV switches the whole integration: anything other than 'live' is
# treated as test, so a missing value costs a failed UAT payment, never a real
# one. TLYNC_BASE_URL is only for overriding the confirmed defaults:
#   test  https://uat-api.tlync.ly/api/v3
#   live  https://api.tlync.ly/api/v3
TLYNC_ENV=test
TLYNC_BASE_URL=
# Store id (the `id` field on payment/initiate, `store_id` on the receipt call).
TLYNC_STORE_ID=
# Per-store bearer token. Both variables must be set or the LYD option does not
# render at all — an option that cannot complete is worse than one fewer.
TLYNC_TOKEN=
# OPTIONAL, and empty is the expected state: TLYNC has published no egress IPs.
# A comma-separated allowlist narrows who may POST the backend callback. It is
# defence in depth only — the callback is never trusted on its own; every paid
# decision is re-confirmed against receipt/transaction server-side.
TLYNC_CALLBACK_IPS=
#
# ⚠️ NO REFUND API EXISTS. A rejected or timed-out TLYNC booking opens a row in
# public.manual_refunds and notifies staff (DB trigger). Nothing in this
# codebase refunds a TLYNC payment.
#
# ⚠️ The USD→LYD rate is NOT an env var and is never hardcoded. It is read at
# payment time from public.currencies (code 'LYD'), falling back to
# public.app_settings key 'fx_usd_lyd'. With neither set, the LYD option stays
# hidden.

# Sweep secret for POST /api/payment/tlync/reconcile. TLYNC's UAT does not POST
# backend_url, so a guest who pays and closes the tab would otherwise leave a
# collected payment unrecorded until the hold expired. The sweep asks TLYNC
# about every unresolved attempt and settles what it confirms. Unset = the
# route is closed (503). `openssl rand -hex 32`.
# Run it every ~5 minutes, matching expire_holds — pg_cron + pg_net alongside
# the existing refund_url job is the natural home.
TLYNC_RECONCILE_SECRET=

# Facebook app id, used ONLY to offer "Messenger" in the desktop share sheet on
# a unit page (facebook.com/dialog/send rejects the request without one). Unset
# = the Messenger row is hidden and the other targets are unaffected. Phones are
# unaffected either way: they get the OS share sheet, which lists Messenger
# itself. Public value, safe in the browser bundle.
NEXT_PUBLIC_FACEBOOK_APP_ID=

# CDN edge in front of Supabase Storage for images (a pull zone whose origin is
# the Storage host — e.g. https://homesta.b-cdn.net or https://img.homestastay.com).
# The Supabase project is in Korea; an 84 KB thumbnail measured 2.7s to a
# visitor in Türkiye, almost all of it round-trip latency.
#
# ONLY the hostname is swapped: the /storage/v1/render/image/... path and every
# width/quality/resize parameter are passed through unchanged, so the CDN must
# forward the full path to Storage as its origin.
#
# UNSET = images stay on the Supabase origin, exactly as before. That is the
# revert. Read at build time (NEXT_PUBLIC_*), so it applies on the next deploy.
NEXT_PUBLIC_IMAGE_HOST=

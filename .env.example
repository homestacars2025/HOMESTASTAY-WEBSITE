# Supabase — Homesta Stay
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Server-only: NEVER import this in Client Components
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Resend
RESEND_API_KEY=re_xxxxxxxxxxxxx

# Mapbox — public token for the unit-detail map. Ships to the browser, so
# restrict it by URL in the Mapbox dashboard. Without it the map section hides.
NEXT_PUBLIC_MAPBOX_TOKEN=pk.xxxxxxxxxxxxx

# ── Origins — TWO variables, deliberately not one ─────────────────────────────
# They are identical in production and MUST differ on preview.
#
# Canonical: ALWAYS the production origin, on every deployment including
# previews. Canonical/hreflang/OG must point at production, or each preview
# advertises itself as canonical and invites Google to index it.
# Note the www host: the apex 307-redirects to www.
NEXT_PUBLIC_CANONICAL_URL=https://www.homestastay.com

# Payment callback: the origin the BANK must reach for THIS deployment. It is
# hashed into HashData, so it has to be byte-identical to where the bank
# actually lands — use the stable branch alias on preview (never the
# per-deployment URL, which changes on every push), and pin the www host: a
# 307 from the apex is exactly the mismatch that surfaces as HashDataError.
# Server-only on purpose — no NEXT_PUBLIC_ prefix, so it cannot be reached for
# by accident when writing a canonical tag.
PAYMENT_CALLBACK_ORIGIN=https://www.homestastay.com

# ── Booking flow ──────────────────────────────────────────────────────────────
# Signs the httpOnly cookie carrying booking_id from the details form to the
# payment step. Any long random string: `openssl rand -base64 32`.
# Rotating it invalidates in-flight holds — guests restart, nothing worse.
BOOKING_COOKIE_SECRET=replace-me-openssl-rand-base64-32

# ── Kuveyt Türk 3D Secure — server-only, Phase B ──────────────────────────────
# NEVER give these a NEXT_PUBLIC_ prefix. Real values belong in .env.local and
# the Vercel dashboard, never in a committed file.
#
# CustomerId is the Müşteri No and is NOT the same as MerchantId (Mağaza No).
# Setting both to the Mağaza No fails at provision with InvalidMetaData.
#
# Do NOT log into the bank panel as the API user. A panel password change
# invalidates the credential at the API layer while the panel still shows it
# valid, producing a permanent HashDataError with no way back.
#
# All bank traffic must go through the proxy — its IP is whitelisted at the
# bank and Vercel's egress IPs are not, so direct calls time out.
KUVEYT_MERCHANT_ID=
KUVEYT_CUSTOMER_ID=
KUVEYT_API_USERNAME=
KUVEYT_API_PASSWORD=
KUVEYT_PROXY_BASE_URL=https://pay-proxy-caddy.gdsddq.easypanel.host

# ── Refund (SaleReversal / DrawBack / PartialDrawback) — server-only ──────────
# The refund is SOAP 1.1 to the WCF query API, reusing the KUVEYT_* credentials
# above and going through the same proxy. The production host is the same BOA
# host the payment proxy already reaches; only the path differs — and it MUST
# end in `.svc/Basic` (the basicHttpBinding endpoint). A POST to the bare `.svc`
# 404s; `.svc/Basic` returns a real SOAP envelope. Verified live + against the
# mews/pos KuveytPos reference. Stays gated until a live reversal is verified
# end-to-end.
#
# Shared secret the trigger (resolve_owner_reply → pg_net) must send as the
# x-refund-secret header. Without it the route is closed. `openssl rand -hex 32`.
REFUND_TRIGGER_SECRET=
# 'true' to allow the actual bank call. Anything else = gated (no bank call).
REFUND_LIVE_ENABLED=
# SOAPAction base = WCF contract + '/' + operation (SaleReversal|DrawBack|
# PartialDrawback). This is the confirmed value; override only to experiment.
KUVEYT_REFUND_SOAP_ACTION_BASE=http://boa.net/BOA.Integration.VirtualPos/Service/IVirtualPosService
# The WCF query-API path. MUST end in `.svc/Basic` — the bare `.svc` 404s on POST.
KUVEYT_REFUND_SERVICE_PATH=/BOA.Integration.WCFService/BOA.Integration.VirtualPos/VirtualPosService.svc/Basic

# ── Cache invalidation ────────────────────────────────────────────────────────
# Shared secret for /api/revalidate. Supabase Database Webhooks send it as the
# x-revalidate-secret header. Unset = the route is closed. `openssl rand -hex 32`.
REVALIDATE_SECRET=

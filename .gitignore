# Environment variables — never commit secrets
.env.local
.env.development.local
.env.test.local
.env.production.local
# `vercel env pull <name>` writes wherever it is told, and a name like
# preview.env matches none of the patterns above. Catch every .env file,
# whatever it is called.
*.env
.env

